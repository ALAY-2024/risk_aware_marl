{
  "name": "PrimalCVaR",
  "risk_level": 0.25,
  "cost_limit": 10,
  "hidden_dim": 64,
  "feature_dim": 32,
  "embedding_dim": 8,
  "num_quantiles": 8,
  "num_hidden_layers": 1,
  "device": "cpu",
  "weight_init": "orthogonal",
  "discount_reward": 0.99,
  "discount_cost": 0.97,
  "buffer_size": 1024,
  "train_start_size": 16,
  "train_steps_per_update": 1,
  "actor_update_freq": 2,
  "cost_multiplier_update_freq": 2,
  "update_lambda_after_step": 0,
  "consider_risk_after_step": 0,
  "batch_size": 16,
  "learning_rate": 0.0001,
  "update_method": "soft",
  "soft_update_tau": 0.05,
  "hard_update_interval": 1,
  "max_grad_norm": 0.5,
  "max_action_prob": 0.99,
  "actor_use_layer_norm": true,
  "critic_use_layer_norm": true,
  "softmax_temperature": 1
